{
  "project": "AI Document Assistant",
  "base_url": "http://127.0.0.1:9000/api",
  "tests": [
    {
      "name": "Upload document",
      "method": "POST",
      "endpoint": "/ai-assistant/documents/",
      "content_type": "multipart/form-data",
      "form_data": {
        "file": "sample_smart_contract_agreement.docx"
      }
    },
    {
      "name": "Process document",
      "method": "POST",
      "endpoint": "/ai-assistant/documents/{id}/process/"
    },
    {
      "name": "Ask question",
      "method": "POST",
      "endpoint": "/ai-assistant/documents/{id}/ask/",
      "json": {
        "question": "What are the payment terms?",
        "top_k": 5
      }
    },
    {
      "name": "Guardrail",
      "method": "POST",
      "endpoint": "/ai-assistant/documents/{id}/ask/",
      "json": {
        "question": "What is the CEO's phone number?",
        "top_k": 5
      }
    }
  ]
}