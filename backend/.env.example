# Local development can run with DEBUG=True and this sample key.
# Production must set DEBUG=False, APP_ENV=Production and a strong unique
# SECRET_KEY (at least 50 random characters). Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DEBUG=True
APP_ENV=Development
SECRET_KEY=change-me-to-a-long-random-secret

# DB_NAME, DB_USER, DB_PASSWORD and DB_HOST are required when DEBUG=False.
DB_NAME=erp_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Required when DEBUG=False; "*" is rejected.
ALLOWED_HOSTS=127.0.0.1,localhost

# Frontend/API browser access. In production, set explicit HTTPS origins.
# CORS_ALLOW_ALL_ORIGINS=True is rejected when DEBUG=False. The SPA sends a
# Bearer token, so CORS_ALLOW_CREDENTIALS can stay False.
CORS_ALLOWED_ORIGINS=http://localhost:5173
CORS_ALLOW_CREDENTIALS=False
CORS_ALLOW_ALL_ORIGINS=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# HTTPS hardening. These local values are for development only: with
# DEBUG=False, session and CSRF cookies are always Secure, and SSL redirect and
# HSTS default to on (only disable them if a proxy already enforces HTTPS).
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
USE_X_FORWARDED_PROTO=False
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True

# Login/refresh rate limit per client IP. Set NUM_PROXIES to the number of
# trusted reverse proxies (e.g. 1 behind nginx) so the real client IP is used.
AUTH_THROTTLE_RATE=10/minute
NUM_PROXIES=0

# /api/schema/, /api/docs/ and /api/redoc/ are public with DEBUG=True and
# staff-only (is_staff) with DEBUG=False. Set to False to remove them entirely.
API_DOCS_ENABLED=True

# Maximum size of an uploaded AI assistant document.
AI_DOCUMENT_MAX_UPLOAD_MB=20

# Root log level for stdout logging (request errors are always logged).
LOG_LEVEL=WARNING
